<policies>
    <inbound>
        <trace source="__MCP_TRACE_SOURCE__" severity="information">
            <message>__MCP_DISPLAY_NAME__ request reached APIM inbound policy</message>
            <metadata name="requestId" value="@(context.RequestId.ToString())" />
        </trace>
        <base />
        <validate-azure-ad-token tenant-id="{{entraid-tenant}}" failed-validation-httpcode="401" failed-validation-error-message="Unauthorized">
            <audiences>
                <audience>{{mcp-client-audience}}</audience>
                <audience>{{obo-client-id}}</audience>
            </audiences>
        </validate-azure-ad-token>
        <set-variable name="incoming_access_token" value="@(context.Request.Headers.GetValueOrDefault(&quot;Authorization&quot;, &quot;&quot;).Replace(&quot;Bearer &quot;, &quot;&quot;))" />
        <authentication-managed-identity resource="api://AzureADTokenExchange" client-id="{{obo-managed-identity-client-id}}" output-token-variable-name="obo_client_assertion" ignore-error="false" />
        <set-variable name="obo_body" value="@{
                var form =
                    $&quot;client_id={{obo-client-id}}&quot; +
                    $&quot;&amp;client_assertion_type=urn:ietf:params:oauth:client-assertion-type:jwt-bearer&quot; +
                    $&quot;&amp;client_assertion={System.Uri.EscapeDataString((string)context.Variables[&quot;obo_client_assertion&quot;])}&quot; +
                    $&quot;&amp;grant_type=urn:ietf:params:oauth:grant-type:jwt-bearer&quot; +
                    $&quot;&amp;requested_token_use=on_behalf_of&quot; +
                    $&quot;&amp;scope={System.Uri.EscapeDataString(&quot;{{remote-mcp-scope}}&quot;)}&quot; +
                    $&quot;&amp;assertion={System.Uri.EscapeDataString((string)context.Variables[&quot;incoming_access_token&quot;])}&quot;;
                return form;
            }" />
        <send-request ignore-error="false" timeout="30" response-variable-name="obo_token_resp">
            <set-url>https://login.microsoftonline.com/{{entraid-tenant}}/oauth2/v2.0/token</set-url>
            <set-method>POST</set-method>
            <set-header name="Content-Type" exists-action="override">
                <value>application/x-www-form-urlencoded</value>
            </set-header>
            <set-body>@((string)context.Variables["obo_body"])</set-body>
        </send-request>
        <choose>
            <when condition="@(!(context.Variables.ContainsKey(&quot;obo_token_resp&quot;)))">
                <return-response>
                    <set-status code="502" reason="Bad Gateway" />
                    <set-body>{"error":"token_exchange_failed","error_description":"No response from token endpoint"}</set-body>
                </return-response>
            </when>
        </choose>
        <trace source="__MCP_TRACE_SOURCE__" severity="information">
            <message>__MCP_DISPLAY_NAME__ OBO token endpoint responded</message>
            <metadata name="statusCode" value="@(((IResponse)context.Variables[&quot;obo_token_resp&quot;]).StatusCode.ToString())" />
        </trace>
        <set-variable name="obo_json" value="@{
                var response = (IResponse)context.Variables[&quot;obo_token_resp&quot;];
                return response.Body.As&lt;JObject&gt;(preserveContent: true);
            }" />
        <choose>
            <when condition="@(((JObject)context.Variables[&quot;obo_json&quot;]).GetValue(&quot;access_token&quot;) == null)">
                <return-response>
                    <set-status code="401" reason="Unauthorized" />
                    <set-body>@(((JObject)context.Variables["obo_json"]).ToString())</set-body>
                </return-response>
            </when>
        </choose>
        <set-variable name="downstream_access_token" value="@(((JObject)context.Variables[&quot;obo_json&quot;]).Value&lt;string&gt;(&quot;access_token&quot;))" />
        <set-header name="Authorization" exists-action="override">
            <value>@("Bearer " + (string)context.Variables["downstream_access_token"])</value>
        </set-header>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <trace source="__MCP_TRACE_SOURCE__" severity="error">
            <message>__MCP_DISPLAY_NAME__ policy processing failed</message>
            <metadata name="source" value="@(context.LastError.Source)" />
            <metadata name="reason" value="@(context.LastError.Reason)" />
        </trace>
        <base />
        <choose>
            <when condition="@(context.Response.StatusCode == 401)">
                <return-response>
                    <set-status code="401" reason="Unauthorized" />
                    <set-header name="WWW-Authenticate" exists-action="override">
                        <value>@{
                            var gatewayUrl = "{{APIMGatewayURL}}";
                            var apiPath = context.Api.Path.Trim('/');
                            return "Bearer error=\"invalid_token\", resource_metadata=\"" + gatewayUrl + "/.well-known/oauth-protected-resource/" + apiPath + "\"";
                        }</value>
                    </set-header>
                </return-response>
            </when>
        </choose>
    </on-error>
</policies>
